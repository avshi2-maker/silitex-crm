{
  "crons": [
    {
      "path": "/api/cron/daily-brief",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/crawl",
      "schedule": "30 1 * * 0"
    },
    {
      "path": "/api/cron/hub-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/visibility",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron/insight",
      "schedule": "30 3 * * 0"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)(wp-admin|wp-login|wp-content|wp-includes|xmlrpc\\.php|phpmyadmin|phpMyAdmin|\\.env|\\.git/|\\.aws|\\.ssh|cgi-bin|vendor/phpunit|server-status|\\.sql|\\.bak)(.*)",
      "mitigate": {
        "action": "deny"
      }
    },
    {
      "src": "/(.*)",
      "missing": [
        {
          "type": "header",
          "key": "user-agent"
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    },
    {
      "src": "/(.*)",
      "methods": [
        "TRACE",
        "CONNECT"
      ],
      "mitigate": {
        "action": "deny"
      }
    },
    {
      "src": "/(.*)(\\.\\./|%2e%2e|%2E%2E|<script|%3cscript|%3Cscript|union(%20|\\+)select|UNION(%20|\\+)SELECT|etc/passwd)(.*)",
      "mitigate": {
        "action": "deny"
      }
    }
  ]
}
